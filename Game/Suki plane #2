<script>
window.addEventListener('keydown', function(e){ if(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight"," "].indexOf(e.key) > -1) { e.preventDefault(); } }, false);
window.addEventListener('touchmove', function(e){ e.preventDefault(); }, { passive: false });
