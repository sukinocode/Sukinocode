var joystickZone = document.getElementById('joystick-zone');
var joystickKnob = document.getElementById('joystick-knob');
var isTouchingJoystick = false;
var touchStartPos = { x: 0, y: 0 };
var moveState = { pitch: 0, roll: 0 };
var playerBaseSpeed = 2.2;

joystickZone.addEventListener('touchstart', function(e) {
  isTouchingJoystick = true;
  var touch = e.touches[0];
  var rect = joystickZone.getBoundingClientRect();
  touchStartPos = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
  updateJoystick(touch.clientX, touch.clientY);
}, { passive: false });

window.addEventListener('touchmove', function(e) {
  if (isTouchingJoystick) {
    var touch = e.touches[0];
    updateJoystick(touch.clientX, touch.clientY);
  }
}, { passive: false });

window.addEventListener('touchend', function() {
  if (isTouchingJoystick) {
    isTouchingJoystick = false;
    joystickKnob.style.transform = 'translate(0px, 0px)';
    moveState.roll = 0; moveState.pitch = 0;
  }
});

function updateJoystick(clientX, clientY) {
  var dx = clientX - touchStartPos.x;
  var dy = clientY - touchStartPos.y;
  var dist = Math.sqrt(dx * dx + dy * dy);
  var maxDist = 50;
  
  if (dist > maxDist) {
    dx = (dx / dist) * maxDist;
    dy = (dy / dist) * maxDist;
  }
  
  joystickKnob.style.transform = 'translate(' + dx + 'px, ' + dy + 'px)';
  moveState.roll = dx / maxDist;
  moveState.pitch = dy / maxDist;
}

var keys = {};
window.addEventListener('keydown', function(e) { keys[e.key.toLowerCase()] = true; });
window.addEventListener('keyup', function(e) { keys[e.key.toLowerCase()] = false; });

function handleKeyboard() {
  if (!isTouchingJoystick) {
    if (keys['w'] || keys['arrowup']) moveState.pitch = -1;
    else if (keys['s'] || keys['arrowdown']) moveState.pitch = 1;
    else moveState.pitch = 0;

    if (keys['a'] || keys['arrowleft']) moveState.roll = -1;
    else if (keys['d'] || keys['arrowright']) moveState.roll = 1;
    else moveState.roll = 0;
  }
}

function setTime(time) {
  envConfig.time = time;
  document.querySelectorAll('#settings-panel .setting-section:nth-child(1) .setting-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('time-'+time).classList.add('active');
  
  var sunPos = new THREE.Vector3();
  var moonPos = new THREE.Vector3();
  var skyColor, fogColor;

  switch(time) {
    case 'siang':
      skyColor = 0x87ceeb; fogColor = 0x87ceeb;
      hemiLight.color.setHex(0xffffff); hemiLight.groundColor.setHex(0x445533); hemiLight.intensity = 1.0;
      dirLight.color.setHex(0xffffff); dirLight.intensity = 1.1;
      sunPos.set(1000, 2000, 500); moonPos.set(-1000, -2000, -500);
      sunMat.opacity = 1; moonMat.opacity = 0;
      break;
    case 'sore':
      skyColor = 0xffa07a; fogColor = 0xffa07a;
      hemiLight.color.setHex(0xffd700); hemiLight.groundColor.setHex(0x332211); hemiLight.intensity = 0.8;
      dirLight.color.setHex(0xff4500); dirLight.intensity = 1.3;
      sunPos.set(-2000, 300, 100); moonPos.set(2000, -300, -100);
      sunMat.opacity = 1; moonMat.opacity = 0;
      break;
    case 'malam':
      skyColor = 0x000011; fogColor = 0x000011;
      hemiLight.color.setHex(0x223355); hemiLight.groundColor.setHex(0x000000); hemiLight.intensity = 0.3;
      dirLight.color.setHex(0xaaaaee); dirLight.intensity = 0.5;
      sunPos.set(2000, -800, -500); moonPos.set(200, 800, 500);
      sunMat.opacity = 0; moonMat.opacity = 1;
      break;
  }
  scene.background = new THREE.Color(skyColor);
  scene.fog = new THREE.FogExp2(fogColor, 0.00025);
  dirLight.position.copy(sunPos);
  sunMesh.position.copy(sunPos.clone().normalize().multiplyScalar(4000));
  moonMesh.position.copy(moonPos.clone().normalize().multiplyScalar(4000));
}

function setWeather(weather) {
  envConfig.weather = weather;
  document.querySelectorAll('#settings-panel .setting-section:nth-child(2) .setting-btn').forEach(b => b.classList.remove('active'));
  document.getElementById('weather-'+weather).classList.add('active');
  
  switch(weather) {
    case 'cerah':
      pMaterial.opacity = 0;
      pMaterial.size = 2;
      pMaterial.color.setHex(0xffffff);
      break;
    case 'hujan':
      pMaterial.opacity = 0.5;
      pMaterial.size = 2.5;
      pMaterial.color.setHex(0xaaaaaa);
      break;
    case 'lebat':
      pMaterial.opacity = 0.85;
      pMaterial.size = 3.5;
      pMaterial.color.setHex(0x999999);
      break;
    case 'salju':
      pMaterial.opacity = 0.8;
      pMaterial.size = 4;
      pMaterial.color.setHex(0xffffff);
      break;
  }
}

setTime('siang');
setWeather('cerah');

window.addEventListener('resize', function() {
  camera.aspect = window.innerWidth / window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});

var botTempV1 = new THREE.Vector3();
var botTempV2 = new THREE.Vector3();

function animate() {
  requestAnimationFrame(animate);
  var delta = clock.getDelta();
  var elapsed = clock.getElapsedTime();
  handleKeyboard();

  playerPlane.rotation.y -= moveState.roll * 0.04;
  playerPlane.rotation.x += moveState.pitch * 0.025;
  playerPlane.rotation.x = Math.max(-1.3, Math.min(1.3, playerPlane.rotation.x));
  playerPlane.rotation.z += (-moveState.roll * 0.7 - playerPlane.rotation.z) * 0.1;

  playerPlane.translateZ(playerBaseSpeed);

  var groundY = getTerrainHeight(playerPlane.position.x, playerPlane.position.z);
  if (playerPlane.position.y < groundY + 5) playerPlane.position.y = THREE.MathUtils.lerp(playerPlane.position.y, groundY + 5, 0.2);
  if (playerPlane.position.y > 1500) playerPlane.position.y = 1500;

  var wingTipL = new THREE.Vector3(-1.6, 0.2, -1.0).applyMatrix4(playerPlane.matrixWorld);
  var wingTipR = new THREE.Vector3(1.6, 0.2, -1.0).applyMatrix4(playerPlane.matrixWorld);
  emitSmoke(wingTipL, 0xffffff);
  emitSmoke(wingTipR, 0xffffff);

  var relativeCamOffset = new THREE.Vector3(0, 4, -18);
  var camOffset = relativeCamOffset.applyMatrix4(playerPlane.matrixWorld);
  camera.position.lerp(camOffset, 0.1);
  var lookAtTarget = playerPlane.position.clone().add(new THREE.Vector3(0, 1.5, 8).applyQuaternion(playerPlane.quaternion));
  camera.lookAt(lookAtTarget);

  for(var i=0; i<dynamicClouds.length; i++) {
    var c = dynamicClouds[i];
    if(c.userData.isMerapi) {
      c.rotation.y += delta * 0.05;
    } else {
      c.position.x += c.userData.speed;
      if (c.position.x > 6000) c.position.x = -6000;
    }
  }

  for (var i = 0; i < birds.length; i++) {
    var bird = birds[i];
    var data = bird.userData;
    bird.position.x += Math.cos(data.angle) * data.speed;
    bird.position.z += Math.sin(data.angle) * data.speed;
    bird.rotation.y = -data.angle + Math.PI/2;
    
    data.wingTimer += delta * 12;
    var wingAngle = Math.sin(data.wingTimer) * 0.6;
    data.leftWing.rotation.z = wingAngle;
    data.rightWing.rotation.z = -wingAngle;
    
    if (Math.abs(bird.position.x) > 4000 || Math.abs(bird.position.z) > 4000) data.angle += Math.PI;
    if (Math.random() < 0.01) data.angle += (Math.random()-0.5) * 0.5;
  }

  if (envConfig.weather !== 'cerah') {
    var positions = particles.geometry.attributes.position.array;
    var speedY, speedX;
    switch(envConfig.weather) {
      case 'lebat': speedY = 35; speedX = 4; break;
      case 'hujan': speedY = 18; speedX = 2; break;
      case 'salju': speedY = 5; speedX = 1; break;
    }
    for ( var i = 0; i < positions.length; i += 3 ) {
      positions[i+1] -= speedY;
      positions[i] += Math.sin(elapsed + i) * speedX * delta;
      
      if ( positions[i+1] < 0 ) {
        positions[i+1] = 1200;
        positions[i] = camera.position.x + (Math.random() * 2000 - 1000);
        positions[i+2] = camera.position.z + (Math.random() * 2000 - 1000);
      }
    }
    particles.geometry.attributes.position.needsUpdate = true;
    particles.position.set(camera.position.x, 0, camera.position.z);
  }

  for (var i = 0; i < botPlanes.length; i++) {
    var b = botPlanes[i];
    var data = b.userData;
    
    botTempV1.subVectors(data.targetPos, b.position);
    var distToTarget = botTempV1.length();
    
    if (distToTarget < 100) {
      data.setTarget();
    }
    
    botTempV1.normalize().multiplyScalar(0.2); 
    data.acceleration.add(botTempV1);
    
    botPlanes.forEach((otherBot, idx) => {
      if (i === idx) return;
      botTempV2.subVectors(b.position, otherBot.position);
      var separation = botTempV2.length();
      if (separation < 80) {
        data.acceleration.add(botTempV2.normalize().multiplyScalar(0.25));
      }
    });
    
    var groundYBot = getTerrainHeight(b.position.x, b.position.z);
    if (b.position.y < groundYBot + 30) {
      data.acceleration.y += 0.6;
    }
    
    data.velocity.add(data.acceleration).multiplyScalar(0.98); 
    
    var botSpeed = data.velocity.length();
    var targetSpeed = playerBaseSpeed;
    if (botSpeed > targetSpeed) data.velocity.setLength(targetSpeed);
    if (botSpeed < targetSpeed * 0.8) data.velocity.setLength(targetSpeed * 0.8);
    
    data.acceleration.set(0,0,0);
    
    b.position.add(data.velocity);
    
    botTempV1.copy(b.position).add(data.velocity);
    b.lookAt(botTempV1);
    
    data.stuntTimer += delta;
    if (data.stuntTimer > 10 && !data.isDoingStunt && Math.random() < 0.01) {
      data.isDoingStunt = true;
      data.stuntTimer = 0;
      data.stuntType = Math.random() > 0.5 ? 'roll' : 'loop';
    }
    
    if (data.isDoingStunt) {
      if (data.stuntType === 'roll') b.rotateZ(0.15);
      else b.rotateX(0.1);
      if (data.stuntTimer > 1.5) data.isDoingStunt = false;
    }
    
    var botWingL = new THREE.Vector3(-1.8, 0.3, -1.0).applyMatrix4(b.matrixWorld);
    var botWingR = new THREE.Vector3(1.8, 0.3, -1.0).applyMatrix4(b.matrixWorld);
    emitSmoke(botWingL, data.smokeColor);
    emitSmoke(botWingR, data.smokeColor);
  }

  updateSmoke(delta);
  renderer.render(scene, camera);
}

animate();
</script>
</body>
</html>
